---
import profile from "../data/profile.json";

// "2026-12-03" -> "3. Dezember 2026"; sonst unverändert anzeigen.
const fmtDate = (d: string) =>
  /^\d{4}-\d{2}-\d{2}$/.test(d)
    ? new Date(d).toLocaleDateString("de-CH", { day: "numeric", month: "long", year: "numeric" })
    : d;
---

<section id="about">
  <div class="wrap about-grid">
    <div class="about-main">
      <p class="eyebrow">Über mich</p>
      <h2>{profile.name.split(" ")[0]}, kurz vorgestellt</h2>
      {profile.bio.map((para: string) => <p>{para}</p>)}
      <p><a class="more-link" href="#interests">Neben der Arbeit: meine Interessen &amp; Engagement ↓</a></p>
    </div>

    <aside class="about-side">
      {profile.current && (
        <div class="card-mini">
          <h3>Aktuell</h3>
          <p>{profile.current}</p>
        </div>
      )}

      {profile.events?.length > 0 && (
        <div class="card-mini">
          <h3>Veranstaltungen</h3>
          <ul>
            {profile.events.map((ev: { name: string; date: string; url: string }) => (
              <li>
                <span class="date">{fmtDate(ev.date)}</span>{" "}
                {ev.url ? <a href={ev.url} target="_blank" rel="noopener">{ev.name} ↗</a> : ev.name}
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
  }
  .about-main p { margin: 0 0 1rem; }
  .about-main .about-main-bio { max-width: 62ch; }
  .about-side { display: grid; gap: 1rem; }
  .card-mini {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.25rem;
  }
  .card-mini h3 {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .card-mini ul { margin: 0; padding-left: 0; list-style: none; display: grid; gap: 0.5rem; }
  .card-mini p { margin: 0; color: var(--text-muted); }
  .date { color: var(--text-muted); font-variant-numeric: tabular-nums; font-size: 0.9rem; }
  .more-link { font-weight: 500; }
  @media (max-width: 46rem) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
