---
import credentials from "../data/credentials.json";

type Cred = {
  id: string; title: string; issuer: string; year: number;
  url?: string; file?: string; skills?: string[];
};
// Unfertige Vorlagen nicht anzeigen (gleiche Regel wie in der Pipeline).
const items = (credentials.items as Cred[])
  .filter((c) => c.title && !c.title.includes("[AUSFUELLEN]"))
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));

const byIssuer = new Map<string, Cred[]>();
for (const c of items) {
  const key = c.issuer || "Weitere";
  byIssuer.set(key, [...(byIssuer.get(key) ?? []), c]);
}
---

{items.length > 0 && (
  <section id="credentials">
    <div class="wrap">
      <p class="eyebrow">Weiterbildung</p>
      <h2>Zertifikate &amp; Kurse</h2>
      <p class="lead">
        Die hier genannten Skills sind im <a href="#skills">Skill-Netz</a> als
        belegt markiert und zeigen dort dieses Zertifikat als Nachweis.
      </p>

      <ul class="cred-list">
        {items.map((c) => (
          <li class="cred">
            <div class="cred-main">
              <h3 class="cred-title">
                {c.url
                  ? <a href={c.url} target="_blank" rel="noopener">{c.title} ↗</a>
                  : c.title}
              </h3>
              <p class="cred-meta">
                {c.issuer && <span>{c.issuer}</span>}
                {c.issuer && <span aria-hidden="true"> · </span>}
                <span>{c.year}</span>
                {c.file && (
                  <>
                    <span aria-hidden="true"> · </span>
                    <a href={c.file} target="_blank" rel="noopener">Zertifikat ↗</a>
                  </>
                )}
              </p>
            </div>
            {c.skills && c.skills.length > 0 && (
              <ul class="cred-skills">
                {c.skills.map((s) => <li class="cred-chip">{s}</li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .lead { color: var(--text-muted); margin-top: -0.4rem; max-width: 46rem; }
  .cred-list { list-style: none; margin: 1.6rem 0 0; padding: 0; display: grid; gap: 0.6rem; }
  .cred {
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between;
    gap: 0.6rem 1rem; padding: 0.9rem 1.1rem;
    background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius);
  }
  .cred-title { margin: 0; font-size: 1rem; font-weight: 600; }
  .cred-meta { margin: 0.15rem 0 0; color: var(--text-muted); font-size: 0.86rem; }
  .cred-skills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cred-chip {
    font-size: 0.76rem; padding: 0.2rem 0.6rem; border-radius: 999px;
    background: var(--accent-soft); color: var(--accent); font-weight: 550;
  }
  @media (max-width: 34rem) { .cred { flex-direction: column; align-items: flex-start; } }
</style>
