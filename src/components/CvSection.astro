---
import cv from "../data/cv.json";
const roles = cv.roles;
---

<section id="cv">
  <div class="wrap">
    <p class="eyebrow">Lebenslauf</p>
    <h2>CV — nach Rolle oder auf die Stelle zugeschnitten</h2>
    <p class="lead">
      Eine Datenquelle, mehrere Ansichten: wähle eine Rolle — oder füge eine
      Stellenanzeige ein, und die Seite schneidet den CV auf deine passenden
      Skills zu. Dann direkt als PDF drucken.
    </p>

    <div class="cv-cta">
      <a class="btn btn-primary" href="/cv">CV öffnen &amp; zuschneiden ↗</a>
      <ul class="role-list">
        {roles.map((r: { id: string; label: string }) => (
          <li><a href={`/cv#${r.id}`}>{r.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .lead { color: var(--text-muted); margin-top: -0.4rem; max-width: 46rem; }
  .cv-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.6rem; }
  .role-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .role-list a { font-weight: 500; font-size: 0.92rem; }
</style>
