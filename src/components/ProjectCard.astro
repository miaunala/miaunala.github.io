---
interface Tags { method?: string[]; domain?: string[]; tool?: string[]; }
interface Project {
  id: string;
  title: string;
  summary: string;
  repo?: string;
  year?: number;
  highlight?: boolean;
  tags: Tags;
}
const { project } = Astro.props as { project: Project };

// Flatten tags into [level, value] so the card can colour-code by level.
const levels: (keyof Tags)[] = ["method", "domain", "tool"];
const pills = levels.flatMap((lvl) =>
  (project.tags[lvl] ?? []).map((value) => ({ lvl, value }))
);
const allTags = pills.map((p) => p.value).join("|");
---

<article class="card" data-tags={allTags}>
  <div class="card-head">
    <h3>{project.title}</h3>
    {project.year && <span class="year">{project.year}</span>}
  </div>
  <p class="summary">{project.summary}</p>
  <ul class="pills" aria-label="Tags">
    {pills.map((p) => (
      <li class={`pill pill-${p.lvl}`}>{p.value}</li>
    ))}
  </ul>
  {project.repo && (
    <a class="repo-link" href={project.repo} target="_blank" rel="noopener">
      Repository ↗
    </a>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    box-shadow: var(--shadow);
    transition: transform 0.1s ease, border-color 0.15s ease;
  }
  .card:hover { transform: translateY(-3px); border-color: var(--accent); }
  .card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; }
  .card-head h3 { margin: 0; font-size: 1.25rem; }
  .year { color: var(--text-muted); font-size: 0.85rem; font-variant-numeric: tabular-nums; }
  .summary { color: var(--text-muted); margin: 0; flex: 1; }
  .pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .pill {
    font-size: 0.74rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--text-muted);
    background: transparent;
  }
  .pill-method { color: var(--tag-method); }
  .pill-domain { color: var(--tag-domain); }
  .pill-tool   { color: var(--tag-tool); }
  .repo-link { font-weight: 550; font-size: 0.92rem; margin-top: 0.2rem; }
</style>
