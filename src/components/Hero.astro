---
import profile from "../data/profile.json";
const headerImage = profile.headerImage; // optional path, e.g. "/header.jpg"
---

<section id="top" class={`hero ${headerImage ? "has-image" : ""}`}
  style={headerImage ? `--header-image: url('${headerImage}')` : undefined}>
  <div class="wrap hero-inner">
    {profile.photo && (
      <img class="avatar" src={profile.photo} width="150" height="150"
           alt={`Portrait von ${profile.name}`} />
    )}
    <div class="hero-text">
      {profile.status.open && (
        <span class="status-chip">
          <span class="status-dot" aria-hidden="true"></span>
          {profile.status.text}
        </span>
      )}
      <h1>{profile.name}<span class="handle">@{profile.handle}</span></h1>
      <p class="tagline">{profile.tagline}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#projects">Projekte ansehen</a>
        <a class="btn btn-ghost" href="#booking">Zusammenarbeit</a>
        {profile.links.github && (
          <a class="btn btn-ghost" href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* Default: soft, cool "aurora" mesh built from the theme colours. */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 9vw, 6rem);
    background:
      radial-gradient(38rem 22rem at 8% -25%, color-mix(in srgb, var(--accent-mid) 45%, transparent), transparent 60%),
      radial-gradient(34rem 22rem at 92% 5%, color-mix(in srgb, var(--accent-soft) 95%, transparent), transparent 62%),
      radial-gradient(48rem 30rem at 55% 120%, color-mix(in srgb, var(--accent-mid) 22%, transparent), transparent 60%),
      var(--accent-wash);
    border-bottom: 1px solid var(--border);
  }

  /* Optional: your own header image, laid under a soft theme-tinted overlay. */
  .hero.has-image {
    background:
      linear-gradient(to right,
        color-mix(in srgb, var(--accent-wash) 92%, transparent),
        color-mix(in srgb, var(--accent-wash) 55%, transparent)),
      var(--header-image) center / cover no-repeat;
  }

  .hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .avatar {
    flex: 0 0 auto;
    width: clamp(96px, 18vw, 150px);
    height: clamp(96px, 18vw, 150px);
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--bg-elev);
    box-shadow: var(--shadow);
  }
  .status-chip { margin-bottom: 1.2rem; }
  .handle {
    display: block;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 1rem;
    color: var(--text-muted);
    letter-spacing: 0;
    margin-top: 0.4rem;
  }
  .tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    color: var(--text-muted);
    max-width: 42rem;
    margin-bottom: 2rem;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @media (max-width: 40rem) {
    .hero-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
